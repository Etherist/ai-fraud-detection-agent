# Tesseract OCR Path
TESSERACT_PATH=/usr/bin/tesseract

# Mock API Endpoints (for demo)
# Note: The mock ABR/ATO server runs on port 8001 by default.
# The main FastAPI app runs on port 8000.
MOCK_ABR_API_URL=http://localhost:8001/abr
MOCK_ATO_API_URL=http://localhost:8001/ato

# Risk Score Thresholds (Fixed for Demo)
# Categories: Low < threshold1, Medium < threshold2, High >= threshold2
RISK_SCORE_THRESHOLDS={"Low": 30, "Medium": 70, "High": 100}

# Anomaly Detection Parameters
ISOLATION_FOREST_CONTAMINATION=0.1
ROUND_DOLLAR_THRESHOLD=1000
OUTLIER_AMOUNT_THRESHOLD=50000

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.csv,.pdf

# APRA APS 222 Configuration
APRA_ASSET_CLASSIFICATIONS=Standard,Substandard,Doubtful,Loss
IMPAIRMENT_RATES={"Standard": 0.0, "Substandard": 0.05, "Doubtful": 0.25, "Loss": 1.0}

# Reporting
REPORT_OUTPUT_DIR=reports/
DEFAULT_REPORT_FORMAT=pdf

# AML Watchlist (Mock Data Paths)
AML_WATCHLIST_PATH=data/aml_watchlist.json
SHELL_COMPANY_PATH=data/shell_company_addresses.json

# Security (Production Only)
# ALLOWED_ORIGINS: Comma-separated list of origins allowed to access the API.
# Default is http://localhost:8000 for local demo. In production, set to your frontend domain(s).
# ALLOWED_ORIGINS=http://localhost:8000,https://yourbank.com
